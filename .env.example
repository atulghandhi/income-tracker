# Copy to .env.local and fill in what you use. Everything is optional —
# each feature stays hidden/dormant without its variable.

# Supabase (auth + cloud sync + edge functions). Already has baked-in defaults
# for the production project; override for your own instance.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Effort-metric analytics (docs/AUTOMATION_PLAN.md §1). Project API key from
# PostHog → Settings → Project. No events are sent without it.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Open banking feeds (Stage E). "1" shows the Bank connections panel; the
# backend also needs TRUELAYER_* secrets on the Supabase edge functions.
# VITE_FEEDS_ENABLED=
